rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is number; // App uses Date.now() which is number
    }

    // --- Entities Validation ---

    function isValidTask(data) {
      let requiredFields = ['text', 'completed', 'dueDate', 'createdAt', 'userId'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() <= 12
        && data.text is string && data.text.size() <= 1000
        && data.completed is bool
        && data.dueDate is string && data.dueDate.size() <= 64
        && isValidTimestamp(data.createdAt)
        && data.userId == request.auth.uid
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('sourceTaskId' in data) || data.sourceTaskId is string)
        && (!('panelId' in data) || data.panelId is string)
        && (!('proofRequired' in data) || data.proofRequired is bool)
        && (!('proofImageUrl' in data) || (data.proofImageUrl is string && data.proofImageUrl.size() <= 2048))
        && (!('aiFeedback' in data) || (data.aiFeedback is string && data.aiFeedback.size() <= 5000))
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 500000));
    }

    function isValidPanel(data) {
      let requiredFields = ['title', 'userId', 'order', 'createdAt'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() <= 5
        && data.title is string && data.title.size() <= 128
        && data.userId == request.auth.uid
        && data.order is number
        && isValidTimestamp(data.createdAt)
        && (!('color' in data) || data.color in ['gray', 'blue', 'red']);
    }

    function isValidChat(data) {
      let requiredFields = ['title', 'userId', 'createdAt', 'lastMessageAt'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() == 4
        && data.title is string && data.title.size() <= 200
        && data.userId == request.auth.uid
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.lastMessageAt);
    }

    function isValidMessage(data) {
      let requiredFields = ['chatId', 'userId', 'role', 'content', 'timestamp'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() <= 6
        && data.chatId is string && data.chatId.size() <= 128
        && data.userId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 10000
        && isValidTimestamp(data.timestamp)
        && (!('suggestedTask' in data) || (
           data.suggestedTask.keys().hasAll(['text', 'status'])
           && data.suggestedTask.text is string
           && data.suggestedTask.status in ['suggested', 'added']
           && (!('description' in data.suggestedTask) || data.suggestedTask.description is string)
        ));
    }

    function isValidRoutine(data) {
      let requiredFields = ['userId', 'type', 'taskIds', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() == 4
        && data.userId == request.auth.uid
        && data.type in ['morning', 'evening']
        && data.taskIds is list && data.taskIds.size() <= 50
        && isValidTimestamp(data.updatedAt);
    }

    // --- Collection Routes ---

    match /tasks/{taskId} {
      allow list, get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(taskId) && isValidTask(incoming());
      allow update: if isOwner(existing().userId) 
                    && isValidTask(incoming())
                    && incoming().userId == existing().userId
                    && (
                      // Toggle completion or update metadata
                      incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'text', 'description', 'dueDate', 'panelId', 'proofRequired', 'proofImageUrl', 'aiFeedback', 'audioUrl'])
                    );
      allow delete: if isOwner(existing().userId);
    }

    match /panels/{panelId} {
      allow list, get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(panelId) && isValidPanel(incoming());
      allow update: if isOwner(existing().userId)
                    && isValidPanel(incoming())
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'order', 'color']);
      allow delete: if isOwner(existing().userId);
    }

    match /chats/{chatId} {
      allow list, get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(chatId) && isValidChat(incoming());
      allow update: if isOwner(existing().userId)
                    && isValidChat(incoming())
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessageAt']);
      allow delete: if isOwner(existing().userId);
    }

    match /messages/{messageId} {
      allow list, get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(messageId) && isValidMessage(incoming());
      allow update: if isOwner(existing().userId)
                    && isValidMessage(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['suggestedTask']);
      allow delete: if isOwner(existing().userId);
    }

    match /routines/{routineId} {
      allow list, get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidId(routineId) && isValidRoutine(incoming());
      allow update: if isOwner(existing().userId)
                    && isValidRoutine(incoming())
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['taskIds', 'updatedAt', 'type']);
      allow delete: if isOwner(existing().userId);
    }
  }
}
